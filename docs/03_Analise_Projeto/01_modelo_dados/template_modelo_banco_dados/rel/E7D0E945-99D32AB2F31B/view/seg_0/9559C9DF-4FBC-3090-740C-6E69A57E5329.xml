<userDefinedSQL><![CDATA[SELECT
    t_pess_pessoa.pess_seq_chave,
    t_pess_pessoa.pess_nome,
    t_pess_pessoa.pess_descricao,
    t_pess_pessoa.pess_abreviacao,
    tpefi_pessoa_fisica.pefi_seq_chave,
    tpefi_pessoa_fisica.pefi_num_cpf,
    tpefi_pessoa_fisica.pefi_dsc_nome,
    tpefi_pessoa_fisica.pefi_enu_sexo
FROM
         t_pess_pessoa
    INNER JOIN tpefi_pessoa_fisica ON t_pess_pessoa.pess_seq_chave = tpefi_pessoa_fisica.t_pess_pessoa_pefi_seq_chave]]></userDefinedSQL>
